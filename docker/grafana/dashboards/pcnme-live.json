{
  "uid": "pcnme-live",
  "title": "PCNME live",
  "tags": [
    "pcnme",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "2s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "description": "A live testbed run (run_live.py): tasks, zones and the agents' online learning as they happen. Display only; the thesis numbers come from the Parquet files.",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "constant",
        "query": "pcnme",
        "hide": 2
      },
      {
        "name": "run",
        "label": "Live run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pcnme-influx"
        },
        "refresh": 2,
        "sort": 0,
        "query": "from(bucket: \"pcnme\") |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"live_zone\" and r._field == \"records\")\n  |> group(columns: [\"run\"]) |> last() |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> map(fn: (r) => ({_value: r.run}))",
        "definition": "from(bucket: \"pcnme\") |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"live_zone\" and r._field == \"records\")\n  |> group(columns: [\"run\"]) |> last() |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> map(fn: (r) => ({_value: r.run}))",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "On time (whole run)",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "pcnme-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pcnme-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"live_task\" and r.run == \"${run}\" and r._field =~ /^on_time$/)\n  |> toFloat()\n  |> group()\n  |> mean()\n  |> map(fn: (r) => ({r with _value: r._value * 100.0}))"
        }
      ],
      "id": 1
    },
