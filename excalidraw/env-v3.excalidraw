  {
   "id": "slots_note_1",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5152.337017092419,
   "width": 1249.5500000000002,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 1598658200,
   "version": 59,
   "versionNonce": 379990997,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Execution slots: each node runs only N tasks at once; the rest wait in its in-memory queue. This creates queueing delay and overload.",
   "originalText": "Execution slots: each node runs only N tasks at once; the rest wait in its in-memory queue. This creates queueing delay and overload.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gx",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "slots_note_2",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5176.987017092419,
   "width": 810.1,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 471721966,
   "version": 59,
   "versionNonce": 574409362,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "--cpus: Docker CPU limit; only makes the zone's own work realistic, not the task time.",
   "originalText": "--cpus: Docker CPU limit; only makes the zone's own work realistic, not the task time.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
