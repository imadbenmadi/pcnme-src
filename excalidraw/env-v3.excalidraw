  {
   "id": "te75",
   "type": "text",
   "x": -119.34872952537285,
   "y": 1001.2738556725888,
   "width": 649.8193359375,
   "height": 50,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "seed": 302003102,
   "version": 146,
   "versionNonce": 1822352068,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791969762979,
   "link": null,
   "locked": false,
   "text": "The runner controls every container through the Docker API:\nstarts and stops them, sets netem per scenario, injects failures.",
   "originalText": "The runner controls every container through the Docker API:\nstarts and stops them, sets netem per scenario, injects failures.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b39y",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te76",
   "type": "text",
   "x": 659.6556795879848,
   "y": 998.8937674903216,
   "width": 841.039306640625,
   "height": 75,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "seed": 1615892811,
   "version": 88,
   "versionNonce": 2048291964,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791969837490,
   "link": null,
   "locked": false,
   "text": "Coverage is enforced in the car app: on radio_net every car could reach every zone,\nso a car only talks to the zone covering its simulated position (none in a tunnel).\n",
   "originalText": "Coverage is enforced in the car app: on radio_net every car could reach every zone,\nso a car only talks to the zone covering its simulated position (none in a tunnel).\n",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b39z",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te77",
   "type": "text",
   "x": 1618.993187493602,
   "y": 759.6788023215145,
   "width": 666.0,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "seed": 1083438815,
   "version": 80,
   "versionNonce": 2024941636,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791970440239,
   "link": null,
   "locked": false,
   "text": "Fog sizes come from each zone's time table and slot count.\n--cpus only limits the zone's own work (agent, queue, MQTT).",
   "originalText": "Fog sizes come from each zone's time table and slot count.\n--cpus only limits the zone's own work (agent, queue, MQTT).",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b39zV",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "kmUIjrqT04bTflk92ariC",
   "type": "text",
   "x": 2029.387797282708,
   "y": 366.6657989886594,
   "width": 306.32520826905306,
   "height": 300,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "#a5d8ff",
   "fillStyle": "solid",
   "strokeWidth": 4,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "index": "b39zt",
   "roundness": null,
   "seed": 1493884100,
   "version": 150,
   "versionNonce": 1043540292,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791969762979,
   "created": 1791969749472,
   "link": null,
   "locked": false,
   "text": "Docker lets every car\ncontainer reach every zone,\nwherever the car is. Nothing in\nDocker stops that, because\nDocker has no idea of\ndistance.\nThe fix: the car app blocks it\non purpose. It checks the\ncar’s position on the map and\ntalks only to the zone covering\nthat position. In a tunnel it\ntalks to nobody.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Docker lets every car container reach every zone, wherever the car is. Nothing in Docker stops that, because Docker has no idea of distance.\nThe fix: the car app blocks it on purpose. It checks the car’s position on the map and talks only to the zone covering that position. In a tunnel it talks to nobody.",
   "autoResize": false,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "Egx06HuUXnwi3UHcQiVYy",
   "type": "text",
   "x": 1649.069573561021,
   "y": 922.7164147854597,
   "width": 621.7857572216858,
   "height": 25,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "#a5d8ff",
   "fillStyle": "solid",
   "strokeWidth": 4,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "index": "b39zxV",
   "roundness": null,
   "seed": 414338940,
   "version": 37,
   "versionNonce": 1873916356,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791970369718,
   "created": 1791970196348,
   "link": null,
   "locked": false,
   "text": "Network        Connects             Real thing it copies",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Network        Connects             Real thing it copies",
   "autoResize": false,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "D8DVjTDE9hig23DdwD5Lx",
   "type": "text",
   "x": 1641.833445759916,
   "y": 953.6640309706806,
   "width": 651.1167534780852,
   "height": 25,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "#a5d8ff",
   "fillStyle": "solid",
   "strokeWidth": 4,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "OOn6EQaUnc2ap0xCkD1Yb",
   "index": "b39zy",
   "roundness": null,
   "seed": 1039758916,
   "version": 112,
   "versionNonce": 958080636,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791970273768,
   "created": 1791970196349,
   "link": null,
   "locked": false,
   "text": "radio_net      cars ↔ zones          the 5G or RSU radio",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "radio_net      cars ↔ zones          the 5G or RSU radio",
   "autoResize": false,
