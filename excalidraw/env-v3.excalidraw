  },
  {
   "id": "te245",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4807.23701709242,
   "width": 1325.24,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 394887584,
   "version": 59,
   "versionNonce": 103043268,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "MQTT: a publish/subscribe protocol. Senders publish to a topic (car/42/result); the broker delivers to every subscriber of that topic.",
   "originalText": "MQTT: a publish/subscribe protocol. Senders publish to a topic (car/42/result); the broker delivers to every subscriber of that topic.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3GX",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te246",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4831.887017092419,
   "width": 1295.6599999999999,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 2035206439,
   "version": 59,
   "versionNonce": 845518916,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "EMQX: the broker program (open source, can run as a cluster of machines that act as one). Mosquitto would also work in the testbed.",
   "originalText": "EMQX: the broker program (open source, can run as a cluster of machines that act as one). Mosquitto would also work in the testbed.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3GZ",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te247",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4856.53701709242,
   "width": 1275.9399999999998,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 319760307,
   "version": 59,
   "versionNonce": 1712451524,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Metro edge: a regional site a few ms from every zone, between the zones and the cloud. The broker lives there in the real design.",
   "originalText": "Metro edge: a regional site a few ms from every zone, between the zones and the cloud. The broker lives there in the real design.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gb",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te248",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4881.187017092419,
   "width": 1275.9399999999998,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 1008396568,
   "version": 59,
   "versionNonce": 558323524,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "MQTT is a messenger, not a database: it remembers only the last message of retained topics. All state lives in the zones' memory.",
   "originalText": "MQTT is a messenger, not a database: it remembers only the last message of retained topics. All state lives in the zones' memory.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gd",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te249",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4905.83701709242,
   "width": 1305.52,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 991004122,
   "version": 59,
   "versionNonce": 811847364,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Bulk data over HTTP: a 200 KB frame goes to exactly one node, so it travels zone to zone directly; MQTT carries only small messages.",
   "originalText": "Bulk data over HTTP: a 200 KB frame goes to exactly one node, so it travels zone to zone directly; MQTT carries only small messages.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gf",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te250",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4930.48701709242,
   "width": 1236.5,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 2121493856,
   "version": 59,
   "versionNonce": 604329540,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "QoS 0 = may be lost (GPS, state: a new one comes 100 ms later). QoS 1 = resent until confirmed (results, acks, attach, work).",
   "originalText": "QoS 0 = may be lost (GPS, state: a new one comes 100 ms later). QoS 1 = resent until confirmed (results, acks, attach, work).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gh",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te251",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4955.137017092419,
   "width": 1285.8,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 329595264,
   "version": 70,
   "versionNonce": 1225387460,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Last will: a message the broker publishes for a client that dies; here zone/{id}/status = offline, so neighbours stop choosing it.",
   "originalText": "Last will: a message the broker publishes for a client that dies; here zone/{id}/status = offline, so neighbours stop choosing it.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gj",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te252",
   "type": "text",
   "x": 29.982924840164287,
   "y": 4979.78701709242,
   "width": 1266.08,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 1234026409,
   "version": 59,
   "versionNonce": 546280772,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "State store: this zone's queue and load plus each neighbour's latest copy, with timestamps. The agent reads it; no network call.",
   "originalText": "State store: this zone's queue and load plus each neighbour's latest copy, with timestamps. The agent reads it; no network call.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gl",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te253",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5004.437017092419,
   "width": 1157.62,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 851649605,
   "version": 59,
   "versionNonce": 1475628228,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Car registry: last GPS, speed, heading and current zone of the cars in this zone and the cars whose tasks it anchors.",
   "originalText": "Car registry: last GPS, speed, heading and current zone of the cars in this zone and the cars whose tasks it anchors.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gn",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te254",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5029.08701709242,
   "width": 1246.36,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 633185882,
   "version": 59,
   "versionNonce": 1087771716,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Anchor table: the tasks this zone owns: input (for retries), deadline, where it runs, result copy, ack. Deleted after the ack.",
   "originalText": "Anchor table: the tasks this zone owns: input (for retries), deadline, where it runs, result copy, ack. Deleted after the ack.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gp",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te255",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5053.73701709242,
   "width": 812.52,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 1090665198,
   "version": 59,
   "versionNonce": 1225976772,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "InfluxDB + Grafana: time-series history and live graphs. Never read by a decision.",
   "originalText": "InfluxDB + Grafana: time-series history and live graphs. Never read by a decision.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gr",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te256",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5078.387017092419,
   "width": 989.9999999999999,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 573124783,
   "version": 59,
   "versionNonce": 1925763908,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "MinIO: an S3-style file store on your disk: datasets, models, result files. Plays the cloud storage.",
   "originalText": "MinIO: an S3-style file store on your disk: datasets, models, result files. Plays the cloud storage.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gt",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te257",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5103.03701709242,
   "width": 1009.7199999999999,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 2071981132,
   "version": 59,
   "versionNonce": 1280690884,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "tc netem: Linux traffic control; adds delay, jitter, loss and bandwidth limits to each Docker network.",
   "originalText": "tc netem: Linux traffic control; adds delay, jitter, loss and bandwidth limits to each Docker network.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gv",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te258",
   "type": "text",
   "x": 29.982924840164287,
   "y": 5127.687017092419,
   "width": 1285.8,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 2086486749,
   "version": 59,
   "versionNonce": 1750585924,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "Fast mode: the same Python code with an in-process bus instead of MQTT/HTTP, much faster than real time, for NSGA-II and training.",
   "originalText": "Fast mode: the same Python code with an in-process bus instead of MQTT/HTTP, much faster than real time, for NSGA-II and training.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null,
   "index": "b3Gx",
   "created": null,
   "labelPosition": null,
   "baseFontSize": null
  },
  {
   "id": "te228",
   "type": "text",
   "x": 24.982924840164287,
   "y": 4312.23701709242,
   "width": 245.27999999999997,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "klKtsXF9hjb4IGycE5Ee1",
   "seed": 1692125396,
   "version": 97,
   "versionNonce": 1437395396,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791966993579,
   "link": null,
   "locked": false,
   "text": "7. INTERFACES",
   "originalText": "7. INTERFACES",
   "fontSize": 32,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
